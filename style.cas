:root {
    --purple: #7563ed;
    --dark-purple: #5946d2;
    --light-purple: #f2efff;
    --dark: #24233e;
    --text: #6f7088;
    --white: #ffffff;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: var(--dark);
    background: var(--white);
}

/* Navbar */
.navbar {
    background: rgba(255, 255, 255, 0.96);
    padding: 17px 0;
    border-bottom: 1px solid #eeebff;
}

.navbar-brand {
    font-size: 25px;
    font-weight: bold;
    color: var(--dark);
}

.navbar-brand span,
.footer h4 span {
    color: var(--purple);
}

.nav-link {
    color: var(--dark);
    font-weight: 600;
    margin-left: 15px;
}

.nav-link:hover {
    color: var(--purple);
}

/* Buttons */
.btn {
    border-radius: 9px;
    padding: 12px 22px;
    font-weight: 600;
    transition: 0.3s;
}

.btn-purple {
    background: var(--purple);
    color: white;
    border: 1px solid var(--purple);
}

.btn-purple:hover {
    background: var(--dark-purple);
    color: white;
    transform: translateY(-2px);
}

.btn-outline-purple {
    color: var(--purple);
    border: 1px solid var(--purple);
    margin-left: 8px;
}

.btn-outline-purple:hover {
    background: var(--light-purple);
    color: var(--dark-purple);
}

/* Home Section */
.hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 130px 0 80px;
    background: linear-gradient(120deg, #ffffff, #f4f1ff);
}

.welcome {
    display: inline-block;
    color: var(--purple);
    background: #eae6ff;
    padding: 8px 16px;
    border-radius: 30px;
    font-weight: 600;
    margin-bottom: 20px;
}

.hero-section h1 {
    font-size: clamp(35px, 5vw, 55px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-section h1 span {
    color: var(--purple);
}

.hero-section h3 {
    font-size: 22px;
    margin-bottom: 20px;
}

.hero-text {
    color: var(--text);
    line-height: 1.9;
    max-width: 550px;
    font-size: 16px;
}

/* Circular Profile Photo */
.profile-circle {
    width: 300px;
    height: 300px;
    max-width: 100%;
    margin: auto;
    padding: 8px;
    border: 3px solid var(--purple);
    border-radius: 50%;
    background: white;
    box-shadow: 0 15px 45px rgba(117, 99, 237, 0.18);
    overflow: hidden;
}

.profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
}

.photo-placeholder {
    display: none;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--light-purple);
    color: var(--purple);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
}

.photo-placeholder span {
    font-size: 60px;
}

.photo-placeholder p {
    font-size: 12px;
    padding: 0 12px;
}

/* Common Sections */
.section-padding {
    padding: 85px 0;
}

.lavender-bg {
    background: #f7f5ff;
}

.section-heading {
    text-align: center;
    margin-bottom: 45px;
}

.subtitle {
    color: var(--purple);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 38px;
    font-weight: 800;
    margin: 12px 0;
}

.section-heading > p:last-child {
    color: var(--text);
}

/* About */
.about-card {
    padding: 35px;
    background: white;
    border: 1px solid #eeeaff;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(60, 45, 130, 0.04);
}

.about-card h3 {
    font-weight: bold;
    margin-bottom: 20px;
}

.about-card p,
.about-highlight p {
    color: var(--text);
    line-height: 1.9;
}

.about-highlight {
    padding: 35px;
    border-radius: 18px;
    background: var(--light-purple);
    border: 1px solid #e5dfff;
    text-align: center;
}

.about-icon {
    font-size: 45px;
    color: var(--purple);
    margin-bottom: 15px;
}

.about-highlight h4 {
    font-weight: bold;
}

/* Skills */
.skill-card {
    height: 100%;
    min-height: 155px;
    padding: 20px 10px;
    background: white;
    border: 1px solid #e9e5ff;
    border-radius: 15px;
    text-align: center;
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 25px rgba(90, 70, 190, 0.1);
}

.skill-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    border-radius: 13px;
    font-size: 19px;
    font-weight: bold;
}

.html-icon {
    background: #fff0e8;
    color: #e65d35;
}

.css-icon {
    background: #eaf1ff;
    color: #2867d9;
}

.bootstrap-icon {
    background: #f0e8ff;
    color: #7042bd;
}

.js-icon {
    background: #fff5cf;
    color: #927000;
}

.python-icon {
    background: #e6f5ff;
    color: #2676a8;
}

.sql-icon {
    background: #eeedff;
    color: #6556cf;
}

.skill-card h5 {
    font-size: 15px;
    font-weight: bold;
}

.skill-card p {
    color: var(--text);
    font-size: 12px;
    margin-bottom: 0;
}

/* Projects */
.project-card {
    height: 100%;
    overflow: hidden;
    background: white;
    border: 1px solid #eae6ff;
    border-radius: 18px;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(70, 55, 150, 0.1);
}

.project-preview {
    height: 210px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.portfolio-preview {
    background: linear-gradient(135deg, #ded8ff, #f3f0ff);
    color: #4f40b9;
}

.portfolio-preview span {
    font-size: 28px;
    font-weight: bold;
}

.preview-line {
    width: 55%;
    height: 8px;
    margin-top: 15px;
    background: white;
    border-radius: 10px;
}

.short-line {
    width: 35%;
    margin-top: 8px;
}

.preview-button {
    width: 90px;
    height: 24px;
    background: var(--purple);
    border-radius: 7px;
    margin-top: 15px;
}

.rentivo-preview {
    background: linear-gradient(135deg, #e2e8ff, #cbd5f4);
    color: #303958;
}

.rentivo-title {
    font-size: 32px;
    font-weight: bold;
}

.rentivo-title span {
    color: var(--purple);
}

.car-emoji {
    font-size: 55px;
    margin: 4px 0;
}

.rentivo-preview p {
    font-size: 10px;
    letter-spacing: 3px;
}

.project-content {
    padding: 25px;
}

.project-content h4 {
    font-weight: bold;
    font-size: 21px;
}

.project-content p {
    color: var(--text);
    line-height: 1.8;
}

.project-tag {
    display: inline-block;
    background: var(--light-purple);
    color: var(--dark-purple);
    padding: 6px 12px;
    margin: 4px 3px 0 0;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

/* Contact */
.contact-form {
    background: white;
    padding: 30px;
    border-radius: 18px;
    border: 1px solid #e9e5ff;
    box-shadow: 0 10px 30px rgba(60, 45, 130, 0.04);
}

.form-label {
    font-weight: 600;
    font-size: 14px;
}

.form-control {
    padding: 12px;
    border: 1px solid #e1ddf3;
    border-radius: 9px;
}

.form-control:focus {
    border-color: var(--purple);
    box-shadow: 0 0 0 3px rgba(117, 99, 237, 0.12);
}

.form-message {
    color: var(--dark-purple);
    font-size: 14px;
}

/* Footer */
.footer {
    text-align: center;
    padding: 35px 0;
    background: #25233f;
    color: white;
}

.footer h4 {
    font-weight: bold;
}

.footer p {
    color: #d1cfe2;
    margin-top: 10px;
}

.copyright {
    font-size: 13px;
}

/* Mobile Responsive Design */
@media (max-width: 991px) {
    .navbar-nav {
        padding-top: 15px;
    }

    .nav-link {
        margin-left: 0;
    }

    .hero-section {
        text-align: center;
    }

    .hero-text {
        margin-left: auto;
        margin-right: auto;
    }
}

@media (max-width: 576px) {
    .hero-section {
        padding: 120px 0 60px;
    }

    .profile-circle {
        width: 235px;
        height: 235px;
    }

    .section-padding {
        padding: 65px 0;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    .about-card,
    .about-highlight,
    .contact-form {
        padding: 23px;
    }

    .btn-outline-purple {
        margin-left: 0;
    }
}
 Portfolio laptop illustration */
.portfolio-preview {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 240px;
    background: linear-gradient(135deg, #f3efff, #e7e0ff);
    overflow: hidden;
}

.portfolio-illustration {
    width: 190px;
    position: relative;
    padding-bottom: 12px;
}

.laptop-screen {
    height: 115px;
    background: #ffffff;
    border: 5px solid #8170cc;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 10px 22px rgba(91, 70, 160, 0.15);
}

.code-symbol {
    font-size: 32px;
    font-weight: bold;
    color: #8170cc;
    margin-bottom: 2px;
}

.code-line {
    height: 5px;
    border-radius: 5px;
    background: #d9d0fa;
}

.line-one {
    width: 95px;
}

.line-two {
    width: 65px;
}

.line-three {
    width: 80px;
}

.laptop-base {
    width: 215px;
    height: 9px;
    margin-left: -12px;
    background: #8170cc;
    border-radius: 2px 2px 12px 12px;
}


.about-details {
    margin-top: 20px;
    padding: 18px;
    background: #f6f2ff;
    border-left: 4px solid #8170cc;
    border-radius: 10px;
}

.about-details p {
    margin-bottom: 10px;
    color: #45405a;
    line-height: 1.6;
}

.about-details p:last-child {
    margin-bottom: 0;
}

.about-details strong {
    color: #6c5bb5;
}

/* Improved Skills Cards */
.skill-card {
    background: #ffffff;
    border: 1px solid #eee8ff;
    border-radius: 16px;
    padding: 25px 15px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.skill-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 25px rgba(129, 112, 204, 0.15);
    border-color: #c8baff;
}

.skill-card span {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #f0ebff;
    color: #7564c5;
    font-weight: bold;
    font-size: 18px;
    margin-bottom: 12px;
}

.skill-card h3 {
    font-size: 16px;
    margin-bottom: 7px;
    color: #29263b;
}

.skill-card p {
    font-size: 13px;
    color: #777387;
    margin-bottom: 0;
}

.project-links {
    margin-top: 20px;
}

.project-btn {
    display: inline-block;
    padding: 10px 20px;
    background: #7565c9;
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.3s ease;
}

.project-btn:hover {
    background: #5d4bb0;
    color: #ffffff;
}
